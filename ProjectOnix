local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local GameId = game.GameId

-- URL do carregador premium (esse é o que você quer executar direto)
local STOCK_LOADER_URL = "https://api.luarmor.net/files/v4/loaders/0ae9fe4cf963e3a13d25eed0e2ce5940.lua"

-- Funções Auxiliares Básicas
local function Tween(obj, props, t, style, dir)
	style = style or Enum.EasingStyle.Quint
	dir = dir or Enum.EasingDirection.Out
	TweenService:Create(obj, TweenInfo.new(t, style, dir), props):Play()
end

local function Notify(title, desc, duration)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title or "Quantum Onyx",
			Text = desc or "",
			Duration = duration or 5,
		})
	end)
end

-- ⭐ FUNÇÃO PRINCIPAL: Carregar o Script Premium Direto
local function LoadPremiumScript()
	Notify("Carregando...", "Iniciando script premium...", 3)
	
	pcall(function()
		local scriptContent = game:HttpGet(STOCK_LOADER_URL)
		if scriptContent and #scriptContent > 0 then
			Notify("Sucesso! ✓", "Script premium carregado!", 3)
			loadstring(scriptContent)()
		else
			Notify("Erro", "Falha ao baixar o script.", 3)
		end
	end)
end

-- ⭐ EXECUTA DIRETO QUANDO O SCRIPT INICIA
wait(1) -- Espera 1 segundo para o jogo carregar
LoadPremiumScript()
